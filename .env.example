# Copy to .env (never commit .env). All values below are examples.
NODE_ENV=development
PORT=5100
# Public origin of the app; used for Origin checks on state-changing requests and cookie flags.
APP_ORIGIN=http://localhost:5100
DATABASE_URL=postgres://seo:seo@localhost:5432/seo_dev

# Worker
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=1
# Turn the daily scheduler on in the worker (requires the plan to allow scheduled audits).
SCHEDULER_ENABLED=true

# Crawler
CRAWL_USER_AGENT=PetsySEOBot/0.1 (+https://seo.pet-sy.com/bot)
# DEVELOPMENT ONLY: send crawl traffic through an HTTP CONNECT proxy (for sandboxes without DNS).
# Refused when NODE_ENV=production because IP pinning (SSRF protection) is impossible through a proxy.
# CRAWL_DEV_PROXY=http://127.0.0.1:41911

# Not configured yet (later phases) - leave empty until real credentials exist:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# BILLING_PROVIDER=
# SECRETS_ENCRYPTION_KEY=
